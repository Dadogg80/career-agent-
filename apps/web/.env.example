# Backend address; server-side only. No API key is required for the foundation.
CAREER_API_BASE_URL=http://127.0.0.1:8080
# Browser-visible backend origin for the local OIDC redirect (server-side configuration).
BACKEND_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Minimum browser-side pause after FINN retrieval (0–120 seconds). Public, not a secret.
NEXT_PUBLIC_ANALYSIS_DELAY_SECONDS=10
# Diagnostics are on in npm run dev; opt in for a pilot production build if needed.
# NEXT_PUBLIC_JOB_DIAGNOSTICS=true
