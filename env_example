# Copy to apps/backend/.env; this file contains names/examples only.
GROQ_API_KEY=""
# Optional, needed only for Compose and the persistence Spring profile.
DATABASE_PASSWORD=""

# Optional local original-document path (relative to apps/backend by default).
# DOCUMENT_STORAGE_PATH=local-data/documents

# Optional task models; empty values fall back to GROQ_MODEL (20B by default).
# Leave these unset until a source-grounded quality comparison passes.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_JOB_MODEL=
# GROQ_DOCUMENT_MODEL=
# GROQ_PROFILE_MODEL=
# GROQ_MATCH_MODEL=

# Whole-document workflow attempt budget and delay between its sequential calls.
# The legacy single/combined analysis API has a separate process-local counter.
# DOCUMENT_AI_MAX_REQUESTS=40
# DOCUMENT_AI_BATCH_DELAY_SECONDS=65

# Optional Gemini integration; values are examples, never real keys.
# GEMINI_API_KEY=
# AI_PROVIDER=groq
# Gemini job/match fallback; document/profile defaults are independently Flash Lite.
# GEMINI_MODEL=gemini-3.6-flash
# AI_JOB_PROVIDER=
# AI_DOCUMENT_PROVIDER=
# AI_PROFILE_PROVIDER=
# AI_MATCH_PROVIDER=
# GEMINI_JOB_MODEL=
# Optional explicit override (default gemini-3.5-flash-lite).
# GEMINI_DOCUMENT_MODEL=
# Optional explicit override (default gemini-3.5-flash-lite).
# GEMINI_PROFILE_MODEL=
# GEMINI_MATCH_MODEL=
# DOCUMENT_GEMINI_BATCH_DELAY_SECONDS=5

# Optional job-specific CV text suggestions (explicit per-run approval).
# AI_TAILORING_PROVIDER=
# Gemini default is independently gemini-3.5-flash-lite.
# GEMINI_TAILORING_MODEL=
# GROQ_TAILORING_MODEL=
# TAILORING_AI_MAX_REQUESTS=5

# Optional OpenAI Responses API; leave existing task/provider defaults unchanged.
# Store credentials only in the ignored backend .env or managed secret settings.
# OPENAI_API_KEY=
# Managed cloud alternative when OPENAI_ environment names are reserved:
# CAREER_OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_JOB_MODEL=
# OPENAI_DOCUMENT_MODEL=
# OPENAI_PROFILE_MODEL=
# OPENAI_MATCH_MODEL=
# OPENAI_TAILORING_MODEL=
# Explicit per-task selection uses AI_JOB_PROVIDER=openai, etc.
# OpenAI does not support JOB_SOURCE_RETRIEVAL in this adapter.

# OpenAI output budgets include reasoning tokens. Task values override the global value.
# OPENAI_MAX_OUTPUT_TOKENS=32768
# OPENAI_JOB_MAX_OUTPUT_TOKENS=32768
# OPENAI_DOCUMENT_MAX_OUTPUT_TOKENS=32768
# OPENAI_PROFILE_MAX_OUTPUT_TOKENS=16384
# OPENAI_MATCH_MAX_OUTPUT_TOKENS=32768
# OPENAI_TAILORING_MAX_OUTPUT_TOKENS=32768
# Allowed reasoning: medium (default) or high. Timeout range: 30–300 seconds.
# OPENAI_REASONING_EFFORT=medium
# OPENAI_REQUEST_TIMEOUT_SECONDS=300
